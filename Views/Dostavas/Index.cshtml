@model IEnumerable<BentoLab.Models.Dostava>

@{
    ViewData["Title"] = "Index";
}

<h1>Index</h1>

<p>
    <a asp-action="Create">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Adresa)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.KontaktTelefon)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.CijenaDostave)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.VrijemeIsporuke)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Napomena)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Narudzba)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.Adresa)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.KontaktTelefon)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.CijenaDostave)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.VrijemeIsporuke)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Napomena)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Narudzba.NarudzbaID)
            </td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.DostavaID">Edit</a> |
                <a asp-action="Details" asp-route-id="@item.DostavaID">Details</a> |
                <a asp-action="Delete" asp-route-id="@item.DostavaID">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
