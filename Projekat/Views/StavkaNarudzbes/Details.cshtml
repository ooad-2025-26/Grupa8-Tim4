@model BentoLab.Models.StavkaNarudzbe

@{
    ViewData["Title"] = "Detalji stavke narudžbe";
}

<h1>Detalji stavke narudžbe</h1>

<div>
    <h4>Stavka narudžbe</h4>
    <hr />

    <dl class="row">
        <dt class="col-sm-2">
            Količina
        </dt>
        <dd class="col-sm-10">
            @Model.Kolicina
        </dd>

        <dt class="col-sm-2">
            Cijena stavke
        </dt>
        <dd class="col-sm-10">
            @Model.CijenaStavke KM
        </dd>

        <dt class="col-sm-2">
            Narudžba
        </dt>
        <dd class="col-sm-10">
            Narudžba #@Model.NarudzbaID
        </dd>

        <dt class="col-sm-2">
            Torta
        </dt>
        <dd class="col-sm-10">
            @Model.Torta?.Naziv
        </dd>

        <dt class="col-sm-2">
            Ukupno
        </dt>
        <dd class="col-sm-10">
            @(Model.Kolicina * Model.CijenaStavke) KM
        </dd>
    </dl>
</div>

<div>
    <a asp-action="Edit" asp-route-id="@Model?.StavkaID">Uredi</a> |
    <a asp-action="Index">Nazad na listu</a>
</div>
