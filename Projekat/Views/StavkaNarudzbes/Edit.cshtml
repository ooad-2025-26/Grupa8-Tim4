@model BentoLab.Models.StavkaNarudzbe

@{
    ViewData["Title"] = "Uredi stavku";
}

<h1>Uredi stavku narudžbe</h1>
<hr />

<div class="row">
    <div class="col-md-4">
        <form asp-action="Edit" method="post">
            <input type="hidden" asp-for="StavkaID" />
            <input type="hidden" asp-for="NarudzbaID" />
            <input type="hidden" asp-for="CijenaStavke" />

            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="form-group">
                <label asp-for="Kolicina">Količina</label>
                <input asp-for="Kolicina" class="form-control" />
                <span asp-validation-for="Kolicina" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="TortaID">Torta</label>
                <select asp-for="TortaID" class="form-control" asp-items="ViewBag.TortaID"></select>
                <span asp-validation-for="TortaID" class="text-danger"></span>
            </div>

            <br />
            <button type="submit" class="btn btn-primary">Sačuvaj</button>
        </form>
    </div>
</div>

<br />
<a asp-action="Index">Nazad na listu</a>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
