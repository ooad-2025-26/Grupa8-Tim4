<h1>Detalji narudžbe</h1>
<hr />

<dl class="row">
    <dt class="col-sm-3">Ukupna cijena</dt>
    <dd class="col-sm-9">@Model.UkupnaCijena KM</dd>

    <dt class="col-sm-3">Status</dt>
    <dd class="col-sm-9">@Model.Status</dd>

    <dt class="col-sm-3">Datum narudžbe</dt>
    <dd class="col-sm-9">@Model.DatumNarudzbe.ToString("dd.MM.yyyy HH:mm")</dd>

    <dt class="col-sm-3">Datum preuzimanja</dt>
    <dd class="col-sm-9">@Model.DatumPreuzimanja.ToString("dd.MM.yyyy HH:mm")</dd>

    <dt class="col-sm-3">Način preuzimanja</dt>
    <dd class="col-sm-9">@Model.NacinPreuzimanja</dd>

