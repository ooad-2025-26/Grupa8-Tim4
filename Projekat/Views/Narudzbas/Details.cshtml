@if (Model.Stavke != null && Model.Stavke.Any())
{
    <h4>Stavke narudžbe</h4>

    <table class="table">
        <thead>
            <tr>
                <th>Torta</th>
                <th>Količina</th>
                <th>Cijena</th>
                <th>Ukupno</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var stavka in Model.Stavke)
            {
                <tr>
                    <td>@stavka.Torta?.Naziv</td>
                    <td>@stavka.Kolicina</td>
                    <td>@stavka.CijenaStavke KM</td>
                    <td>@(stavka.Kolicina * stavka.CijenaStavke) KM</td>
                </tr>
            }
        </tbody>
    </table>
}

