@model BentoLab.Models.Narudzba

@{
    ViewData["Title"] = "Detalji Narudžbe";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>Detalji Narudžbe #@Model.NarudzbaID</h2>
        <a asp-action="Index" class="btn btn-secondary">Nazad na pregled narudžbi</a>
    </div>

    <div class="row">
        <div class="col-md-5">
            <div class="card shadow-sm mb-4">
                <div class="card-header bg-dark text-white">
                    <h5 class="mb-0">Podaci o narudžbi</h5>
                </div>
                <div class="card-body">
                    <p><strong>Datum narudžbe:</strong> @Model.DatumNarudzbe.ToString("dd.MM.yyyy HH:mm")</p>
                    <p><strong>Datum preuzimanja:</strong> @Model.DatumPreuzimanja.ToString("dd.MM.yyyy HH:mm")</p>
                    <p><strong>Način preuzimanja:</strong> @Model.NacinPreuzimanja</p>
                    <p><strong>Status:</strong> <span class="badge bg-primary">@Model.Status</span></p>
                    <p><strong>Ukupna cijena:</strong> <strong class="text-success">@Model.UkupnaCijena KM</strong></p>
                </div>
            </div>
        </div>

        <div class="col-md-7">
            <div class="card shadow-sm">
                <div class="card-header bg-primary text-white">
                    <h5 class="mb-0">Stavke narudžbe</h5>
                </div>
                <div class="card-body p-0">
                    <table class="table table-hover mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Stavka ID</th>
                                <th>Količina</th>
                                <th>Cijena stavke</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model.Stavke != null && Model.Stavke.Any())
                            {
                                @foreach (var stavka in Model.Stavke)
                                {
                                    <tr>
                                        <td>#@stavka.StavkaID</td>
                                        <td>@stavka.Kolicina x</td>
                                        <td>@stavka.CijenaStavke KM</td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="3" class="text-center text-muted p-3">Nema stavki za ovu narudžbu.</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>