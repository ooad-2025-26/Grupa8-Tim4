@model BentoLab.Models.Narudzba
@using BentoLab.Models

@{
    ViewData["Title"] = "Kreiranje narudžbe";
}

<div class="container mt-4" style="max-width: 500px;">
    <h2>Kreiranje nove narudžbe</h2>
    <hr />
    
    <form asp-action="Create" method="post">
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

        <div class="form-group mb-3">
            <label asp-for="DatumPreuzimanja" class="control-label">Datum i vrijeme preuzimanja/dostave</label>
            <input asp-for="DatumPreuzimanja" class="form-control" type="datetime-local" />
            <span asp-validation-for="DatumPreuzimanja" class="text-danger"></span>
        </div>

        <div class="form-group mb-4">
            <label asp-for="NacinPreuzimanja" class="control-label">Način preuzimanja</label>
            <select asp-for="NacinPreuzimanja" class="form-control">
                <option value="LICNO_PREUZIMANJE">Lično preuzimanje</option>
                <option value="DOSTAVA">Dostava na adresu</option>
            </select>
            <span asp-validation-for="NacinPreuzimanja" class="text-danger"></span>
        </div>

        <div class="form-group">
            <button type="submit" class="btn btn-primary w-100">Potvrdi i kreiraj narudžbu</button>
        </div>
    </form>

    <div class="mt-3 text-center">
        <a asp-action="Index" class="btn btn-link">Nazad na pregled narudžbi</a>
    </div>
</div>