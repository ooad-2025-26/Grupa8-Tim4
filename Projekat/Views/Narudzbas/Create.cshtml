@model BentoLab.Models.Narudzba

@{
    ViewData["Title"] = "Kreiranje narudžbe";
}

<div class="container mt-4" style="max-width: 600px;">
    <div class="card shadow-sm">
        <div class="card-header bg-primary text-white text-center">
            <h3 class="mb-0">Kreirajte Vašu Narudžbu</h3>
        </div>
        <div class="card-body p-4">
            <form asp-action="Create" method="post">

                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                <div class="form-group mb-4">
                    <label asp-for="DatumNarudzbe" class="form-label fw-bold">
                        Datum isporuke / preuzimanja:
                    </label>
                    <input asp-for="DatumNarudzbe"
                           type="date"
                           class="form-control form-control-lg"
                           min="@DateTime.Today.ToString("yyyy-MM-dd")" />
                    <span asp-validation-for="DatumNarudzbe" class="text-danger"></span>

                    <div class="form-text">
                        Primamo maksimalno 5 narudžbi po danu.
                    </div>
                </div>

                <div class="form-group mb-4">
                    <label asp-for="NacinPreuzimanja" class="form-label fw-bold">
                        Način preuzimanja:
                    </label>

                    <select asp-for="NacinPreuzimanja"
                            class="form-select form-control-lg"
                            asp-items="Html.GetEnumSelectList<BentoLab.Models.NacinPreuzimanja>()">
                        <option value="">-- Odaberite opciju --</option>
                    </select>

                    <span asp-validation-for="NacinPreuzimanja" class="text-danger"></span>
                </div>

                <hr class="my-4" />

                <div class="d-grid gap-2">
                    <button type="submit" class="btn btn-success btn-lg">
                        Nastavi
                    </button>

                    <a asp-action="Index" class="btn btn-outline-secondary">
                        Nazad na pregled narudžbi
                    </a>
                </div>

            </form>
        </div>
    </div>
</div>

@section Scripts
{
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}