@{
    ViewData["Title"] = "Kreiraj Narudžbu";
}

<div class="container mt-4" style="max-width: 600px;">
    <div class="card shadow-sm border-0 rounded-lg">
        <div class="card-body p-4">
            <h2 class="text-dark font-weight-bold mb-4">Kreiranje nove narudžbe</h2>
            
            <form asp-controller="Narudzbas" asp-action="Create" method="post">
                
                <div class="mb-4">
                    <label class="form-label text-secondary small font-weight-bold">Datum i vrijeme preuzimanja/dostave</label>
                    <input type="datetime-local" name="datumPreuzimanja" value="@ViewBag.TrenutniDatum" class="form-control form-control-lg text-muted" required />
                </div>

                <div class="mb-4">
                    <label class="form-label text-secondary small font-weight-bold">Način preuzimanja</label>
                    <select name="nacinPreuzimanjaStr" class="form-select form-select-lg">
                        <option value="LICNO">Lično preuzimanje</option>
                        <option value="DOSTAVA">Dostava na kućnu adresu</option>
                    </select>
                </div>

                <div class="d-grid gap-2 pt-2">
                    <button type="submit" class="btn btn-primary btn-lg shadow-sm">Potvrdi i kreiraj narudžbu</button>
                    <a asp-action="Index" class="btn btn-link text-primary mt-2">Nazad na pregled narudžbi</a>
                </div>
            </form>
        </div>
    </div>
</div>