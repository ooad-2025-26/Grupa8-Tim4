@model IEnumerable<BentoLab.Models.Narudzba>

@{
    ViewData["Title"] = "Pregled Narudžbi";
}

<div class="container mt-4">
    <h1 class="mb-3">Narudžbe</h1>

    <p>
        <a asp-controller="Torta" asp-action="Index" class="btn btn-primary btn-lg shadow-sm">Kreiraj novu narudžbu</a>
    </p>

    <div class="card shadow-sm mt-4">
        <div class="card-body p-0">
            <table class="table table-striped table-hover mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Ukupna cijena</th>
                        <th>Status</th>
                        <th>Datum narudžbe</th>
                        <th>Datum preuzimanja</th>
                        <th>Način preuzimanja</th>
                        <th>Akcije</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td><strong>@item.UkupnaCijena KM</strong></td>
                            <td>
                                <span class="badge @(item.Status.ToString() == "ZAVRSENA" ? "bg-success" : "bg-warning text-dark")">
                                    @item.Status
                                </span>
                            </td>
                            <td>@item.DatumNarudzbe.ToString("dd.MM.yyyy HH:mm")</td>
                            <td>@item.DatumPreuzimanja.ToString("dd.MM.yyyy HH:mm")</td>
                            <td>@item.NacinPreuzimanja</td>
                            <td>
                                <a asp-action="Details" asp-route-id="@item.NarudzbaID" class="btn btn-sm btn-outline-primary">Detalji</a> |
                                <a asp-action="Delete" asp-route-id="@item.NarudzbaID" class="btn btn-sm btn-outline-danger">Obriši</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <div class="card-footer bg-white p-3">
            <h5>Ukupan broj narudžbi: <span class="badge bg-secondary">@Model.Count()</span></h5>
        </div>
    </div>
</div>