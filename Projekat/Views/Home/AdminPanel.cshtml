@{
    ViewData["Title"] = "Admin Panel";
}
<style>
    body {
        background-color: #fcf8f2;
        font-family: 'Montserrat', sans-serif;
    }
    .admin-wrapper {
        max-width: 780px;
        margin: 70px auto;
        background: #ffffff;
        border-radius: 24px;
        padding: 45px;
        box-shadow: 0 10px 35px rgba(93, 64, 55, 0.10);
        border: 1px solid rgba(226, 155, 131, 0.25);
    }
    .admin-title {
        font-family: 'Playfair Display', serif;
        color: #5d4037;
        font-size: 3rem;
        font-weight: 700;
        text-align: center;
    }
    .admin-subtitle {
        color: #8d6e63;
        text-align: center;
        margin-bottom: 35px;
    }
    .admin-card-link {
        display: block;
        text-decoration: none;
        background: #f7ede2;
        border-radius: 18px;
        padding: 30px;
        height: 100%;
        border: 1px solid rgba(226, 155, 131, 0.3);
        color: #5d4037;
        transition: 0.25s ease;
    }
        .admin-card-link:hover {
            transform: translateY(-4px);
            background: #fcefe9;
            color: #5d4037;
            box-shadow: 0 8px 22px rgba(93, 64, 55, 0.13);
        }
    .admin-icon {
        font-size: 2.4rem;
        margin-bottom: 12px;
    }
    .admin-card-title {
        font-weight: 700;
        font-size: 1.3rem;
        margin-bottom: 8px;
    }
    .admin-card-text {
        color: #8d6e63;
        margin: 0;
    }
</style>
<div class="admin-wrapper">
    <h1 class="admin-title">BentoLab Admin</h1>
    <p class="admin-subtitle">Odaberite funkcionalnost koju želite koristiti.</p>
    <div class="row g-4">
        <div class="col-md-6">
            <a asp-controller="Home" asp-action="UpravljanjeKorisnicima" class="admin-card-link">
                <div class="admin-icon">👥</div>
                <div class="admin-card-title">Upravljanje korisnicima</div>
                <p class="admin-card-text">Pregled, blokiranje i odblokiranje korisnika.</p>
            </a>
        </div>
        <div class="col-md-6">
            <a asp-controller="AdminNarudzbe" asp-action="Index" class="admin-card-link">
                <div class="admin-icon">📦</div>
                <div class="admin-card-title">Pregled narudžbi</div>
                <p class="admin-card-text">Pregled narudžbi, statusa i slanje slike torte.</p>
            </a>
        </div>
    </div>
</div>
