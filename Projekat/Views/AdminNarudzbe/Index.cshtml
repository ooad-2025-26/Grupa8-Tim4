@model IEnumerable<BentoLab.Models.Narudzba>

@{
    ViewData["Title"] = "Pregled narudžbi";
}

<style>
    body {
        background-color: #fcf8f2;
        font-family: 'Montserrat', sans-serif;
    }

    .admin-card {
        background-color: white;
        border-radius: 18px;
        box-shadow: 0 8px 30px rgba(93,64,55,0.08);
        padding: 35px;
        margin-top: 50px;
        border: 1px solid rgba(93,64,55,0.1);
    }

    .admin-title {
        font-family: 'Playfair Display', serif;
        color: #5d4037;
        font-weight: 700;
        margin-bottom: 10px;
    }

    .admin-subtitle {
        color: #8d6e63;
        margin-bottom: 25px;
    }

    .bento-table-container {
        border-radius: 12px;
        overflow: hidden;
        border: 1px solid rgba(226,155,131,0.2);
    }

    .bento-table {
        width: 100%;
        border-collapse: collapse;
    }

        .bento-table thead th {
            background-color: #e29b83;
            color: white;
            padding: 15px;
            text-transform: uppercase;
            font-size: 0.85rem;
            letter-spacing: 1px;
        }

        .bento-table tbody td {
            padding: 16px;
            color: #5d4037;
            border-bottom: 1px solid rgba(226,155,131,0.1);
            background-color: white;
        }

        .bento-table tbody tr:hover td {
            background-color: #fcefe9;
        }

    .status-badge {
        padding: 6px 14px;
        border-radius: 20px;
        font-size: 0.8rem;
        font-weight: 600;
    }

    .status-kreirana {
        background-color: #dbeafe;
        color: #1e40af;
    }

    .status-potvrdjena {
        background-color: #fef3c7;
        color: #92400e;
    }

    .status-izrada {
        background-color: #ddd6fe;
        color: #5b21b6;
    }

    .status-zavrsena {
        background-color: #dcfce7;
        color: #166534;
    }

    .status-otkazana {
        background-color: #fee2e2;
        color: #991b1b;
    }

    .btn-bento {
        background-color: #d1856c;
        color: white;
        border: none;
        border-radius: 8px;
        padding: 6px 12px;
        font-weight: 500;
    }

        .btn-bento:hover {
            background-color: #bc745d;
            color: white;
        }

    .btn-soft {
        border: 1px solid rgba(226,155,131,0.4);
        color: #5d4037;
        background: white;
        border-radius: 8px;
    }

        .btn-soft:hover {
            background-color: #fcefe9;
            color: #5d4037;
        }

    .akcije {
        display: flex;
        flex-direction: column;
        gap: 6px;
    }
</style>

<div class="container pb-5">

    <div class="admin-card">

        <div class="d-flex justify-content-between align-items-center mb-4">

            <div>
                <h2 class="admin-title">
                    📦 Pregled narudžbi
                </h2>

                <p class="admin-subtitle">
                    Upravljanje svim kreiranim narudžbama i statusima.
                </p>
            </div>

            <a asp-controller="Home"
                   asp-action="AdminPanel"
                   class="btn btn-soft">
                ← Nazad na admin panel
            </a>

        </div>

        <div class="bento-table-container">

            <div class="table-responsive">

                <table class="bento-table">

                    <thead>
                        <tr>
                            <th>ID</th>
                            <th>Korisnik</th>
                            <th>Cijena</th>
                            <th>Datum narudžbe</th>
                            <th>Preuzimanje</th>
                            <th>Status</th>
                            <th>Promjena statusa</th>
                            <th>Akcije</th>
                        </tr>
                    </thead>

                    <tbody>

                        @foreach (var narudzba in Model)
                        {
                            <tr>

                                <td>
                                    <strong>#@narudzba.NarudzbaID</strong>
                                </td>

                                <td>
                                    @narudzba.KorisnikID
                                </td>

                                <td>
                                    @narudzba.UkupnaCijena KM
                                </td>

                                <td>
                                    @narudzba.DatumNarudzbe.ToString("dd.MM.yyyy HH:mm")
                                </td>

                                <td>
                                    @narudzba.DatumPreuzimanja.ToString("dd.MM.yyyy")
                                </td>

                                <td>

                                    @if (narudzba.Status == BentoLab.Models.StatusNarudzbe.KREIRANA)
                                    {
                                        <span class="status-badge status-kreirana">Kreirana</span>
                                    }
                                    else if (narudzba.Status == BentoLab.Models.StatusNarudzbe.POTVRDJENA)
                                    {
                                        <span class="status-badge status-potvrdjena">Potvrđena</span>
                                    }
                                    else if (narudzba.Status == BentoLab.Models.StatusNarudzbe.U_IZRADI)
                                    {
                                        <span class="status-badge status-izrada">U izradi</span>
                                    }
                                    else if (narudzba.Status == BentoLab.Models.StatusNarudzbe.ZAVRSENA)
                                    {
                                        <span class="status-badge status-zavrsena">Završena</span>
                                    }
                                    else
                                    {
                                        <span class="status-badge status-otkazana">Otkazana</span>
                                    }

                                </td>

                                <td>

                                    <form asp-controller="AdminNarudzbe"
                                          asp-action="PromijeniStatus"
                                          method="post"
                                          class="d-flex gap-2">

                                        <input type="hidden"
                                               name="id"
                                               value="@narudzba.NarudzbaID" />

                                        <select name="noviStatus"
                                                class="form-select form-select-sm">

                                            <option value="KREIRANA">Kreirana</option>
                                            <option value="POTVRDJENA">Potvrđena</option>
                                            <option value="U_IZRADI">U izradi</option>
                                            <option value="ZAVRSENA">Završena</option>
                                            <option value="OTKAZANA">Otkazana</option>

                                        </select>

                                        <button type="submit"
                                                class="btn btn-bento">
                                            Spremi
                                        </button>

                                    </form>

                                </td>

                                <td>

                                    <div class="akcije">

                                        <a asp-controller="AdminNarudzbe"
                                               asp-action="Details"
                                               asp-route-id="@narudzba.NarudzbaID"
                                               class="btn btn-soft btn-sm">
                                            Pogledaj stavke
                                        </a>

                                        <a asp-controller="Kamera"
                                               asp-action="UslikajBento"
                                               asp-route-narudzbaId="@narudzba.NarudzbaID"
                                               class="btn btn-bento btn-sm">
                                            📸 Pošalji sliku
                                        </a>

                                    </div>

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>

        </div>

    </div>

</div>
