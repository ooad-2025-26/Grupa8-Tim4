@model IEnumerable<BentoLab.Models.Torta>

@{
    ViewData["Title"] = "Torte";
}

<h1>Torte</h1>

<p>
    <a asp-action="Create" class="btn btn-primary">Dodaj novu tortu</a>
</p>

@if (!Model.Any())
{
    <p>Trenutno nema dodanih torti.</p>
}
else
{
    <table class="table">
        <thead>
            <tr>
                <th>Naziv</th>
                <th>Cijena</th>
                <th>Količina na stanju</th>
                <th>Dostupna</th>
                <th>Akcije</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.Naziv</td>
                    <td>@item.Cijena KM</td>
                    <td>@item.KolicinaNaStanju</td>
                    <td>@(item.Dostupna ? "Da" : "Ne")</td>
                    <td>
                        <a asp-action="Edit" asp-route-id="@item.TortaID">Uredi</a> |
                        <a asp-action="Details" asp-route-id="@item.TortaID">Detalji</a> |
                        <a asp-action="Delete" asp-route-id="@item.TortaID">Obriši</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>

    <h5>Ukupan broj torti: @Model.Count()</h5>
}
