@{
    ViewData["Title"] = "Bento Lab Studio";
}

<div class="container py-5">
    @if (TempData["Poruka"] != null)
    {
        <div class="alert alert-success border-0 shadow-sm mb-4" style="border-radius: 15px; background-color: #d1e7dd; color: #0f5132;">
            <i class="fas fa-check-circle mr-2"></i> @TempData["Poruka"]
        </div>
    }

    <div class="text-center mb-5">
        <h1 class="font-weight-bold" style="color: #b56c60; letter-spacing: -1px; font-size: 3rem;">Bento Lab Studio</h1>
        <p class="text-muted mx-auto" style="max-width: 500px; font-size: 1.1rem;">
            Dobrodošli u Vaš kreativni radni prostor. Ovdje možete pregledati narudžbe u pripremi i aktivirati kameru za finalnu potvrdu.
        </p>
        <div style="width: 60px; height: 3px; background-color: #b56c60; margin: 20px auto; border-radius: 2px;"></div>
    </div>

    <div class="row justify-content-center">
        <div class="col-md-5">
            <div class="card border-0 shadow-sm" style="border-radius: 20px; background-color: #ffffff; transition: 0.3s;">
                <div class="card-body p-4">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <span class="badge px-3 py-2" style="background-color: #fce4ec; color: #ad1457; border-radius: 10px;">U PRIPREMI</span>
                        <small class="text-muted">#CK-0847</small>
                    </div>

                    <h4 class="card-title font-weight-bold mb-1" style="color: #333;">Rođendanska Bento Torta</h4>
                    <p class="text-muted mb-4" style="font-size: 0.9rem;">
                        <i class="fas fa-birthday-cake mr-2"></i> Čokoladni mus | Natpis: <em>"Sretan rođendan!"</em>
                    </p>

                    <div class="d-flex align-items-center p-3 mb-4" style="background-color: #fcf8f7; border-radius: 15px; border: 1px dashed #e0d0cd;">
                        <div class="mr-3" style="font-size: 1.5rem;">📸</div>
                        <small class="text-muted">Potrebno je uslikati tortu prije nego je označite kao spremnu za isporuku.</small>
                    </div>

                    <a href="/Kamera/UslikajBento?narudzbaId=847" class="btn btn-block py-3 shadow-sm text-white"
                       style="background: linear-gradient(135deg, #b56c60 0%, #a18885 100%); border-radius: 15px; font-weight: bold; border: none;">
                        <i class="fas fa-camera mr-2"></i> OTVORI STUDIO I USLIKAJ
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    body {
        background-color: #fdfaf9; 
    }

    .card:hover {
        transform: translateY(-5px);
        box-shadow: 0 10px 20px rgba(181, 108, 96, 0.1) !important;
    }
</style>