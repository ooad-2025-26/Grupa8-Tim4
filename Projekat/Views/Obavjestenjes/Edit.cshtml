@model BentoLab.Models.Obavjestenje

@{
    ViewData["Title"] = "Edit";
}

<h1>Edit</h1>

<h4>Obavjestenje</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Edit">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="ObavjestenjeID" />
            <div class="form-group">
                <label asp-for="Sadrzaj" class="control-label"></label>
                <input asp-for="Sadrzaj" class="form-control" />
                <span asp-validation-for="Sadrzaj" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="DatumSlanja" class="control-label"></label>
                <input asp-for="DatumSlanja" class="form-control" />
                <span asp-validation-for="DatumSlanja" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="KorisnikID" class="control-label"></label>
                <select asp-for="KorisnikID" class="form-control" asp-items="ViewBag.KorisnikID"></select>
                <span asp-validation-for="KorisnikID" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="NarudzbaID" class="control-label"></label>
                <select asp-for="NarudzbaID" class="form-control" asp-items="ViewBag.NarudzbaID"></select>
                <span asp-validation-for="NarudzbaID" class="text-danger"></span>
            </div>
            <div class="form-group">
                <input type="submit" value="Save" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-action="Index">Back to List</a>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
