@model BentoLab.Models.Korpa

@{
    ViewData["Title"] = "Detalji korpe";
}

<h1>Pregled korpe</h1>

<div>
    <h4>Osnovne informacije o korpi</h4>
    <hr />

    <dl class="row">
        <dt class="col-sm-2">
            ID korpe
        </dt>
        <dd class="col-sm-10">
            @Model.KorpaID
        </dd>

        <dt class="col-sm-2">
            Datum kreiranja
        </dt>
        <dd class="col-sm-10">
            @Model.DatumKreiranja.ToString("dd.MM.yyyy")
        </dd>

        <dt class="col-sm-2">
            Korisnik
        </dt>
        <dd class="col-sm-10">
            Korisnik #@Model.KorisnikID
        </dd>
    </dl>
</div>

<div>
    <a asp-action="Edit" asp-route-id="@Model?.KorpaID">Uredi</a> |
    <a asp-action="Index">Nazad na pregled korpi</a>
</div>
