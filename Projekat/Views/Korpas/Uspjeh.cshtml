@{
    ViewData["Title"] = "Narudžba uspješno kreirana";
}

<div class="container my-5 text-center" style="max-width: 500px; font-family: 'Segoe UI', sans-serif;">
    <div class="card p-5" style="border-radius: 25px; border: none; box-shadow: 0 4px 25px rgba(0,0,0,0.06); background-color: #fff;">

        <div class="d-inline-flex align-items-center justify-content-center mb-4" style="width: 80px; height: 80px; background-color: #fdf2f0; border-radius: 50%; color: #b56c60; font-size: 35px; margin: 0 auto;">
            ✓
        </div>

        <span class="badge mb-3 px-3 py-2" style="background-color: #fdf2f0; color: #b56c60; font-weight: bold; font-size: 12px; border-radius: 20px;">NARUDŽBA #CK-0847</span>

        <h4 style="color: #4a2c2a; font-weight: bold; margin-bottom: 10px;">Narudžba uspješno kreirana!</h4>
        <p class="text-muted small mb-4">Vaša narudžba je uspješno zaprimljena. Obavještenja o statusu narudžbe dobit ćete putem emaila.</p>

        <div class="text-start p-3 mb-4" style="background-color: #fafafa; border-radius: 15px;">
            <div class="d-flex justify-content-between align-items-center mb-2">
                <span>📝 <strong>Zaprimljeno</strong></span>
                <span class="badge" style="background-color: #fdf2f0; color: #b56c60;">Trenutno</span>
            </div>
            <div class="text-muted small mb-2">🎂 U pripremi</div>
            <div class="text-muted small mb-2">🚗 Na putu</div>
            <div class="text-muted small">✅ Dostavljeno</div>
        </div>

        <a href="/" class="btn w-100 py-3 text-white" style="background-color: #b56c60; border-radius: 12px; font-weight: bold; border: none;">
            Vrati se na početak
        </a>
    </div>
</div>