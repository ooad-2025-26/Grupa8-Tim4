@{
    ViewData["Title"] = "Vaša Korpa";

    string[] naziviTorti = TempData["NazivKreiraneTorte"] as string[];
    string[] cijeneTorti = TempData["CijenaKreiraneTorte"] as string[];

    TempData.Keep("NazivKreiraneTorte");
    TempData.Keep("CijenaKreiraneTorte");

    double ukupniZbirZaUplatu = 0;
}

<div class="container mt-4" style="max-width: 900px; background-color: #f7ede2; padding: 30px; border-radius: 15px;">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 style="color: #bc6c25; font-weight: bold; margin: 0;">🛒 Vaša Korpa</h2>
        <a asp-controller="Torta" asp-action="Index" class="btn btn-outline-secondary btn-sm" style="border-radius: 8px;">+ Dodaj još proizvoda</a>
    </div>

    <table class="table table-bordered bg-white text-center align-middle shadow-sm overflow-hidden" style="border-radius: 10px;">
        <thead style="background-color: #3d405b; color: white;">
            <tr>
                <th>Naziv proizvoda</th>
                <th>Cijena</th>
                <th>Količina</th>
                <th>Ukupno</th>
                <th>Akcija</th>
            </tr>
        </thead>
        <tbody>
            @if (naziviTorti != null && naziviTorti.Length > 0 && !string.IsNullOrEmpty(naziviTorti[0]))
            {
                for (int i = 0; i < naziviTorti.Length; i++)
                {
                    double trenutnaCijena = double.Parse(cijeneTorti[i], System.Globalization.CultureInfo.InvariantCulture);
                    ukupniZbirZaUplatu += trenutnaCijena;

                    <tr>
                        <td class="fw-bold text-start ps-3" style="color: #3d405b;">🎂 @naziviTorti[i]</td>
                        <td class="fw-bold">@trenutnaCijena.ToString("0.00") KM</td>
                        <td>
                            <span class="badge bg-light text-dark p-2 border">1 kom</span>
                        </td>
                        <td class="fw-bold" style="color: #e07a5f; font-size: 18px;">@trenutnaCijena.ToString("0.00") KM</td>
                        <td>
                            <form asp-controller="Korpas" asp-action="Ukloni" method="post" style="display:inline;">
                                <input type="hidden" name="index" value="@i" />
                                <button type="submit" class="btn btn-sm btn-outline-danger" style="border-radius: 8px;">
                                    Ukloni
                                </button>
                            </form>
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="5" class="text-muted py-5 fs-5">Vaša korpa je trenutno prazna.</td>
                </tr>
            }
        </tbody>
    </table>

    @if (naziviTorti != null && naziviTorti.Length > 0 && !string.IsNullOrEmpty(naziviTorti[0]))
    {
        <div class="d-flex justify-content-end mb-4">
            <div class="p-3 bg-white text-end shadow-sm" style="border-radius: 10px; min-width: 250px; border: 1px solid #dda15e;">
                <span class="text-muted">Ukupno za uplatu:</span>
                <h3 class="fw-bold" style="color: #e07a5f; margin: 0;">@ukupniZbirZaUplatu.ToString("0.00") KM</h3>
            </div>
        </div>

        <div class="d-flex justify-content-end">
            <a asp-controller="Korpas" asp-action="Create" class="btn btn-lg px-5 text-white shadow fw-bold" style="background-color: #bc6c25; border-radius: 10px;">
                ✓ Nastavi na plaćanje &rarr;
            </a>
        </div>
    }
</div>
