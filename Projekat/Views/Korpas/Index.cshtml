@model IEnumerable<BentoLab.Models.Korpa>

@{
    ViewData["Title"] = "Korpe";
}

<h1>Korpe korisnika</h1>

<p>
    <a asp-action="Create" class="btn btn-primary">Kreiraj novu korpu</a>
</p>

@if (!Model.Any())
{
    <p>Trenutno nema kreiranih korpi.</p>
}
else
{
    <table class="table">
        <thead>
            <tr>
                <th>ID korpe</th>
                <th>Datum kreiranja</th>
                <th>Korisnik</th>
                <th>Akcije</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.KorpaID</td>
                    <td>@item.DatumKreiranja.ToString("dd.MM.yyyy")</td>
                    <td>@item.KorisnikID</td>
                    <td>
                        <a asp-action="Details" asp-route-id="@item.KorpaID">Detalji</a> |
                        <a asp-action="Edit" asp-route-id="@item.KorpaID">Uredi</a> |
                        <a asp-action="Delete" asp-route-id="@item.KorpaID">Obriši</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>

    <h5>Ukupan broj korpi: @Model.Count()</h5>
}
