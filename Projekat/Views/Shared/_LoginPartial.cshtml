@using Microsoft.AspNetCore.Identity
@using BentoLab.Models
@inject SignInManager<Korisnik> SignInManager
@inject UserManager<Korisnik> UserManager


<ul class="navbar-nav">
    @if (SignInManager.IsSignedIn(User))
    {
        var korisnik = await UserManager.GetUserAsync(User);
        var ime = korisnik?.ImePrezime?.Split(' ')[0] ?? User.Identity?.Name;

        <li class="nav-item">
            <span class="nav-link" style="color:#8d6e63; font-weight:600;">
                Zdravo, @ime!
            </span>
        </li>
        <li class="nav-item">
            <form asp-area="Identity" asp-page="/Account/Logout"
                  asp-route-returnUrl="@Url.Action("Index", "Home", new { area = "" })">
                <button type="submit" class="nav-link btn btn-link" style="color:#8d6e63; font-weight:600;">
                    Odjava
                </button>
            </form>
        </li>
    }
    else
    {
        <li class="nav-item">
            <a class="nav-link" style="color:#8d6e63; font-weight:600;" asp-area="Identity" asp-page="/Account/Register">Registracija</a>
        </li>
        <li class="nav-item">
            <a class="nav-link" style="color:#8d6e63; font-weight:600;" asp-area="Identity" asp-page="/Account/Login">Prijava</a>
        </li>
    }
</ul>
