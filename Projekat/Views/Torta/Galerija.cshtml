@{
    ViewData["Title"] = "Galerija ideja";
}

<div class="container mt-4" style="background-color: #f7ede2; padding: 30px; border-radius: 15px;">
    <div class="mb-3">
        <a asp-action="Index" class="btn btn-outline-secondary">&larr; Nazad</a>
    </div>

    <h3 class="text-center mb-2" style="color: #bc6c25; font-weight: bold;">Pronađite svoju inspiraciju</h3>
    <p class="text-center text-muted mb-4">Pređite mišem (hover) preko slike za naziv stila koji možete navesti u napomeni</p>

    <div class="row g-3">
        <div class="col-md-3 col-sm-6">
            <div class="card shadow-sm h-100 border-0">
                <img src="~/images/slika1.jpg" title="Stil: Minimalist Blue Sky Pearl" class="card-img-top rounded shadow-sm" alt="Inspiracija 1" style="height: 180px; object-fit: cover;">
            </div>
        </div>
        <div class="col-md-3 col-sm-6">
            <div class="card shadow-sm h-100 border-0">
                <img src="~/images/slika2.jpg" title="Stil: Vintage Lambeth Piping Pink" class="card-img-top rounded shadow-sm" alt="Inspiracija 2" style="height: 180px; object-fit: cover;">
            </div>
        </div>
