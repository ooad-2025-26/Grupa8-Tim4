@{
    ViewData["Title"] = "Izbor Akcije";
}

<div class="container text-center mt-5" style="background-color: #f7ede2; padding: 40px; border-radius: 15px; max-width: 800px;">
    <h2 class="mb-5" style="color: #bc6c25; font-weight: bold;">🎂 Naša Ponuda Bento Torti 🎂</h2>

    <div class="d-grid gap-4 col-8 mx-auto">
        <a asp-controller="Torta" asp-action="Kreiraj" class="btn btn-lg shadow-sm" style="background-color: #dda15e; color: white; border: none; padding: 15px; font-size: 22px;">
            🎂 Kreiraj tortu
        </a>

        <a asp-controller="Torta" asp-action="Galerija" class="btn btn-lg shadow-sm" style="background-color: #faedcd; color: #d4a373; border: 1px solid #d4a373; padding: 15px; font-size: 22px;">
            💡 Galerija ideja
        </a>

        <a asp-controller="Torta" asp-action="Cjenovnik" class="btn btn-lg shadow-sm" style="background-color: #dda15e; color: white; border: none; padding: 15px; font-size: 22px;">
            📋 Pregledaj cjenovnik
        </a>
    </div>
</div>