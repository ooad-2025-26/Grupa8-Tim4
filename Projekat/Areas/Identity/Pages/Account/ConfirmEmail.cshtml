@page
@model ConfirmEmailModel
@{
    ViewData["Title"] = "Slatka pobjeda";
}

<style>
    body {

        background-color: #fcf8f2;
    }
    .custom-card {
        background: #ffffff;
        border-radius: 20px;
        box-shadow: 0 10px 25px rgba(220, 175, 155, 0.15);
        border: none;
    }

    .btn-next {
        background-color: #e29b83;
        color: white;
        border-radius: 10px;
        width: 60px;
        height: 60px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border: none;
        transition: all 0.3s ease;
    }

        .btn-next:hover {
            background-color: #d1856c;
            color: white;
            transform: scale(1.05);
        }

    .success-icon {
        color: #e29b83;
        font-size: 3rem;
    }
</style>

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-5 card p-5 custom-card text-center">
            <div class="mb-3">
                <div class="success-icon">✓</div>
            </div>
            <h2 style="color: #7d5445; font-weight: 700; font-size: 1.8rem;">Slatka pobjeda 🎉</h2>
            <p class="mt-2" style="color: #a47a6c; font-size: 1.2rem; font-weight: 500;">Uspješno ste se registrovali</p>
            
            <div class="mt-5">
                <a href="/Torta" class="btn btn-next shadow-sm">
                    <span style="font-size: 1.5rem; font-weight: bold; color: white;">➔</span>
                </a>
            </div>
        </div>
    </div>
</div>